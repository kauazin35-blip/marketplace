# ===== Cortador de Vídeo Automático — configuração =====
# Copie para .env e ajuste conforme sua máquina.

# --- Transcrição (faster-whisper) ---
WHISPER_MODEL=large-v3       # tiny|base|small|medium|large-v3
WHISPER_DEVICE=cuda          # cuda (GPU RTX 5070) ou cpu
WHISPER_COMPUTE_TYPE=float16 # float16 na GPU | int8 na CPU
# WHISPER_LANGUAGE=pt        # fixe o idioma ou deixe vazio p/ autodetect

# --- IA de cortes ---
LLM_PROVIDER=ollama          # ollama (offline) | claude (API)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b      # ou llama3.1:8b
# Fallback opcional p/ Claude (só se LLM_PROVIDER=claude):
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-opus-4-8

# --- Geração de cortes ---
MAX_CLIPS=10
CLIP_MIN_SECONDS=15
CLIP_MAX_SECONDS=75
OUT_WIDTH=1080
OUT_HEIGHT=1920
BURN_CAPTIONS=true
CAPTION_WORDS_PER_CHUNK=3
